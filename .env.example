PORT=3000
HOST=localhost
NODE_ENV=development

HASHTAGCMS_CONTEXT=procms
HASHTAGCMS_API_SECRET=YOUR_HASHTAGCMS_API_SECRET
HASHTAGCMS_API_BASE_URL=http://localhost:8080
HASHTAGCMS_CONFIG_API=http://localhost:8080/api/hashtagcms/public/configs/v1/site-configs
HASHTAGCMS_DATA_API=http://localhost:8080/api/hashtagcms/public/sites/v1/load-data
HASHTAGCMS_BLOG_API=http://localhost:8080/api/hashtagcms/public/sites/v1/blog/latests
HASHTAGCMS_LOGIN_API=http://localhost:8080/api/hashtagcms/public/user/v1/login
HASHTAGCMS_LOGOUT_API=http://localhost:8080/api/hashtagcms/public/user/v1/logout
HASHTAGCMS_PUBLISH_API=http://localhost:8080/api/hashtagcms/public/kpi/v1/publish
HASHTAGCMS_USER_ME_API=http://localhost:8080/api/hashtagcms/public/user/v1/me
HASHTAGCMS_USER_PROFILE_UPDATE_API=http://localhost:8080/api/hashtagcms/public/user/v1/profile
HASHTAGCMS_CONTACT_API=http://localhost:8080/api/hashtagcms/public/common/v1/contact
HASHTAGCMS_SUBSCRIBE_API=http://localhost:8080/api/hashtagcms/public/common/v1/subscribe

HASHTAGCMS_QUERY_PARAMS_TO_LOAD_DATA=limit


# Cache & Timeout Settings (in seconds/minutes)
HASHTAG_CMS_EXTERNAL_SERVICE_TIMEOUT=30
HASHTAG_CMS_EXTERNAL_CONFIG_CACHE_TTL=60
HASHTAG_CMS_EXTERNAL_DATA_CACHE_TTL=30
CACHE_API_SECRET=YOUR_CACHE_API_SECRET

# Asset Base Path (theme assets will be appended: /assets/hashtagcms/fe/{theme})
ASSET_BASE_PATH=/assets/hashtagcms/fe

# Admin Panel URL
ADMIN_BASE_URL=http://localhost:8000/admin

# Supported Languages (comma-separated, for startup preloading)
SUPPORTED_LANGUAGES=en,hi

# Session Secret (change in production!)
SESSION_SECRET=YOUR_SESSION_SECRET
SESSION_MAX_AGE=86400000

# Optional: Redis Session Store
# If not configured, will use in-memory sessions (default)
# Uncomment and configure to enable Redis:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
#REDIS_DB=0

# Load-Data Cache TTL (seconds) - only used if Redis is enabled
LOAD_DATA_CACHE_TTL=300

# Cache API Key (optional in development, REQUIRED in production!)
# CACHE_API_SECRET=your_secure_cache_api_key

# Optional: Asset URL (if using CDN)
ASSET_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

ASSETS_VERSION=110120260728


