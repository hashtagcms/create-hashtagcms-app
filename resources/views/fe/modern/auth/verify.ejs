<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <%= helper.trans("hashtagcms::auth.Verify Your Email Address") %>
                </div>

                <div class="card-body">
                    <% if (locals.resent) { %>
                        <div class="alert alert-success" role="alert">
                            <%= helper.trans("hashtagcms::auth.A fresh verification link has been sent to your email
                                address.") %>
                        </div>
                        <% } %>
                            Before proceeding, please check your email for a verification link.
                            If you did not receive the email, <a href="/verification/resend">click here to request
                                another</a>.
                </div>
            </div>
        </div>
    </div>
</div>