<% const inputs=locals.inputs || {}; const errors=locals.errors || {}; %>
    <div class="container" style="margin-top: 50px;margin-bottom: 50px">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <%= helper.trans('hashtagcms::auth.Register') %>
                    </div>

                    <div class="card-body">
                        <form method="POST" action="/register">
                            <!-- CSRF -->

                            <div class="form-group row">
                                <label for="name" class="col-md-4 col-form-label text-md-right">
                                    <%= helper.trans('hashtagcms::auth.Name') %>
                                </label>

                                <div class="col-md-6">
                                    <input id="name" type="text"
                                        class="form-control <%= errors.name ? 'is-invalid' : '' %>" name="name"
                                        value="<%= inputs.name || '' %>" required autofocus>

                                    <% if (errors.name) { %>
                                        <span class="invalid-feedback" role="alert" style="display:block">
                                            <strong>
                                                <%= errors.name %>
                                            </strong>
                                        </span>
                                        <% } %>
                                </div>
                            </div>

                            <div class="form-group row mt-2">
                                <label for="email" class="col-md-4 col-form-label text-md-right">
                                    <%= helper.trans('hashtagcms::auth.E-Mail Address') %>
                                </label>

                                <div class="col-md-6">
                                    <input id="email" type="email"
                                        class="form-control <%= errors.email ? 'is-invalid' : '' %>" name="email"
                                        value="<%= inputs.email || '' %>" required>

                                    <% if (errors.email) { %>
                                        <span class="invalid-feedback" role="alert" style="display:block">
                                            <strong>
                                                <%= errors.email %>
                                            </strong>
                                        </span>
                                        <% } %>
                                </div>
                            </div>

                            <div class="form-group row mt-2">
                                <label for="password" class="col-md-4 col-form-label text-md-right">
                                    <%= helper.trans('hashtagcms::auth.Password') %>
                                </label>

                                <div class="col-md-6">
                                    <input id="password" type="password"
                                        class="form-control <%= errors.password ? 'is-invalid' : '' %>" name="password"
                                        required>

                                    <% if (errors.password) { %>
                                        <span class="invalid-feedback" role="alert" style="display:block">
                                            <strong>
                                                <%= errors.password %>
                                            </strong>
                                        </span>
                                        <% } %>
                                </div>
                            </div>

                            <div class="form-group row mt-2">
                                <label for="password-confirm" class="col-md-4 col-form-label text-md-right">
                                    <%= helper.trans('hashtagcms::auth.Confirm Password') %>
                                </label>

                                <div class="col-md-6">
                                    <input id="password-confirm" type="password" class="form-control"
                                        name="password_confirmation" required>
                                </div>
                            </div>

                            <div class="form-group row mt-2">
                                <div class="col-md-6 offset-md-4">
                                    <button type="submit" class="btn btn-primary">
                                        <%= helper.trans('hashtagcms::auth.Register') %>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>