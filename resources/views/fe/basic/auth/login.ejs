<% const errorCode=locals.error_code || 0; const inputs=locals.inputs || {}; const errors=locals.errors || {}; const
    redirect=locals.redirect || inputs.redirect || '' ; %>
    <div class="container" style="margin-top: 100px;margin-bottom: 100px">

        <% if(errorCode> 0) { %>
            <div class="row justify-content-center">
                <% const errorMessage=locals.error_message || '' ; %>
                    <div class="alert-danger alert">
                        <%- errorMessage %>
                    </div>
            </div>
            <% } else { %>
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <%= helper.trans('hashtagcms::auth.Login') %>
                            </div>
                            <div class="card-body">
                                <form method="POST" action="/login">
                                    <!-- CSRF -->
                                    <% if(redirect) { %>
                                        <input id="redirect" type="hidden" name="redirect" value="<%= redirect %>">
                                        <% } %>

                                            <div class="form-group row mt-2">
                                                <label for="email" class="col-sm-4 col-form-label text-md-right">
                                                    <%= helper.trans('hashtagcms::auth.Email Address') %>
                                                </label>

                                                <div class="col-md-6">
                                                    <input id="email" type="email"
                                                        class="form-control <%= errors.email ? 'is-invalid' : '' %>"
                                                        name="email" value="<%= inputs.email || '' %>" required
                                                        autofocus>

                                                    <% if (errors.email) { %>
                                                        <span class="invalid-feedback" role="alert"
                                                            style="display:block">
                                                            <strong>
                                                                <%= errors.email %>
                                                            </strong>
                                                        </span>
                                                        <% } %>
                                                </div>
                                            </div>

                                            <div class="form-group row mt-2">
                                                <label for="password" class="col-md-4 col-form-label text-md-right">
                                                    <%= helper.trans('hashtagcms::auth.Password') %>
                                                </label>
                                                <div class="col-md-6">
                                                    <input id="password" type="password"
                                                        class="form-control <%= errors.password ? 'is-invalid' : '' %>"
                                                        name="password" required>
                                                    <% if (errors.password) { %>
                                                        <span class="invalid-feedback" role="alert"
                                                            style="display:block">
                                                            <strong>
                                                                <%= errors.password %>
                                                            </strong>
                                                        </span>
                                                        <% } %>
                                                </div>
                                            </div>

                                            <div class="form-group row mt-2">
                                                <div class="col-md-6 offset-md-4">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="remember"
                                                            id="remember" <%=inputs.remember ? 'checked' : '' %>>
                                                        <label class="form-check-label" for="remember">
                                                            <%= helper.trans('hashtagcms::auth.Remember Me') %>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-0">
                                                <div class="col-md-8 offset-md-4">
                                                    <button type="submit" class="btn btn-primary">
                                                        <%= helper.trans('hashtagcms::auth.Login') %>
                                                    </button>

                                                    <a class="btn btn-link" href="/password/reset">
                                                        <%= helper.trans('hashtagcms::auth.Forgot Your Password?') %>
                                                    </a>
                                                </div>
                                            </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
    </div>