<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Page Not Found</title>
    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            padding: 50px;
        }

        h1 {
            font-size: 50px;
        }

        p {
            font-size: 20px;
        }
    </style>
</head>

<body>
    <h1>404</h1>
    <p>
        <%= typeof message !=='undefined' ? message : 'Page not found' %>
    </p>
    <a href="/">Go Home</a>
</body>

</html>